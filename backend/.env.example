# ROUTELESS backend environment (all values optional; defaults shown)
# The server reads process.env directly — export these or pass them via Docker.
PORT=3000
# Default: <repo>/data/routeless.db
DB_PATH=./data/routeless.db
# Comma-separated CORS origin, or * for the demo
FRONTEND_URL=http://localhost:5173
# Demo scenario clock in minutes after midnight (480 = 08:00)
DEMO_NOW_MIN=480
